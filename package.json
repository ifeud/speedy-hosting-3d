{
  "name": "speedy-hosting",
  "version": "4.0.0",
  "private": true,
  "description": "Independent voxel-inspired game hosting website with original illustrations, open-license fonts and embedded single-file assets.",
  "scripts": {
    "build:scene": "esbuild tools/scene.js --bundle --format=iife --minify --legal-comments=inline --outfile=assets/v2/scene.min.js",
    "build": "npm run build:scene && python tools/build.py",
    "preview": "python -m http.server 3000 --bind 0.0.0.0 --directory public",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "vercel": "61.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
